    <resource path="src/org/eclipse/equinox/p2/core/StrongPool.java" type="org.eclipse.equinox.p2.core.StrongPool">
        <filter comment="StrongPool is the default implementation of IPool. IPool is intended to be used through StrongPool and WeakPool, so the leak is intentional." id="576725006">
